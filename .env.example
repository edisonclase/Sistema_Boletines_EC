# ============================================================
# AULA NOVA - CONFIGURACIÓN DE EJEMPLO
# Copiar este archivo como .env y completar los valores locales.
# Nunca almacenar contraseñas reales en este archivo.
# ============================================================

# Aplicación
APP_NAME=Aula Nova
APP_ENV=development
APP_DEBUG=true

# Seguridad
SECRET_KEY=CHANGE_THIS_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============================================================
# FUENTES DE DATOS ACADÉMICOS
# ============================================================

URL_PRIMER_CICLO=
URL_SEGUNDO_CICLO=

URL_CONTROL_ASISTENCIA_COMPLETIVO_PRIMER_CICLO=
URL_CONTROL_ASISTENCIA_COMPLETIVO_SEGUNDO_CICLO=

# ============================================================
# BASE DE DATOS
# Sustituir usuario, contraseña, servidor y nombre de base.
# No utilizar contraseñas reales en este archivo.
# ============================================================

DATABASE_URL=postgresql+psycopg://postgres:CHANGE_THIS_PASSWORD@127.0.0.1:5432/clase_edutech

# ============================================================
# GENERACIÓN DE PDF
# ============================================================

PDF_ENGINE=wkhtmltopdf
WKHTMLTOPDF_PATH=C:\Program Files\wkhtmltopdf\bin\wkhtmltopdf.exe

# Usar rutas locales según la ubicación del proyecto.
INSTITUTION_LOGO=F:\proyectos\AulaNova\app\pdf\assets\logo.png
INSTITUTION_MINERD_LOGO=F:\proyectos\AulaNova\app\pdf\assets\minerd.png
INSTITUTION_LETTERHEAD=F:\proyectos\AulaNova\app\pdf\assets\membrete.png

# ============================================================
# INFORMACIÓN INSTITUCIONAL
# ============================================================

INSTITUTION_NAME=Politécnico Prof. José Mercedes Alvino
INSTITUTION_CODE=14601
INSTITUTION_MOTTO=Formando con Amor Seres Justos y Competentes.
INSTITUTION_ADDRESS=Avenida Hispanoamericana, Santiago, República Dominicana
INSTITUTION_EMAIL=
INSTITUTION_PHONE=
INSTITUTION_ACADEMIC_DEPARTMENT=Departamento de Registro y Control Académico
INSTITUTION_DIRECTOR=

# ============================================================
# INFORMACIÓN DEL DOCUMENTO
# ============================================================

BULLETIN_GENERATED_BY=Aula Nova
BULLETIN_GENERATED_ROLE=Coordinación de Registro y Control Académico
BULLETIN_AUTHOR=Aula Nova

# ============================================================
# REGLAS ACADÉMICAS
# ============================================================

PASSING_GRADE=70
LOW_GRADE_HIGHLIGHT_COLOR=#FFF59D